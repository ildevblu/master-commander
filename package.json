{
  "name": "master-commander",
  "version": "0.1.0",
  "description": "A cross-platform command center for local software projects.",
  "desktopName": "Master Commander",
  "main": "out/main/index.js",
  "author": {
    "name": "ildevblu",
    "email": "9204657+ildevblu@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/ildevblu/master-commander#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ildevblu/master-commander.git"
  },
  "bugs": {
    "url": "https://github.com/ildevblu/master-commander/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist": "npm run build && electron-builder --win nsis portable --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "dev.mastercommander.app",
    "productName": "Master Commander",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
